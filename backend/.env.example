# ─────────── Database ───────────
# Default: SQLite (zero setup, cocok dev & single-gate)
DATABASE_URL="file:./dev.db"
# Untuk production Postgres:
# DATABASE_URL="postgresql://afvs:afvs_password@localhost:5432/afvs?schema=public"

# ─────────── JWT ───────────
# WAJIB ≥32 char acak (mis. `openssl rand -base64 48`). Tanpa ini backend gagal-cepat (F-01).
JWT_SECRET="ganti-dengan-string-random-min-32-char-aaaaaa"
JWT_EXPIRES_IN="12h"
# Masa berlaku token perangkat (kiosk) yang diizinkan admin — diperpanjang otomatis.
DEVICE_TOKEN_EXPIRES_IN="12h"
# HMAC untuk pinLookup (login-PIN O(1), P-05/P-06). Set acak & stabil.
PIN_LOOKUP_SECRET="ganti-dengan-string-random-lain-min-32-char"

# ─────────── App ───────────
PORT=3001
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"

# ─────────── Observability (opsional) ───────────
# DSN project Sentry (platform Node.js). Kosongkan → Sentry nonaktif (no-op).
SENTRY_DSN=""

# ─────────── File Storage ───────────
UPLOAD_DIR="./uploads"
UPLOAD_MAX_SIZE=1048576
# F-06 (UU PDP): retensi foto wajah/biometrik — hapus otomatis setelah N hari.
FACE_RETENTION_DAYS=30
# Log aktivitas (menu Admin > Log Aktivitas) dipangkas setelah N hari.
ACTIVITY_LOG_RETENTION_DAYS=180

# ─────────── Bootstrap admin ───────────
SEED_ADMIN_EMAIL="admin@afvs.local"
SEED_ADMIN_PASSWORD="ChangeMe!2026"
SEED_ADMIN_NAME="Admin"

# Server-to-server PJP2U reconciliation. Empty disables access; minimum 32 characters.
FINANCE_INTEGRATION_TOKEN=""
