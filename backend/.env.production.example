# ─────────── AFVS Backend — PROFIL PRODUKSI (template) ───────────
# Salin ke `.env` di server produksi & isi nilai nyata. Backend GAGAL-CEPAT
# (F-03) bila CORS_ORIGIN=localhost/kosong atau DATABASE_URL pakai user root.

# Database — WAJIB user khusus berhak minimal + password kuat (BUKAN root).
DATABASE_URL="mysql://afvs_app:GANTI_PASSWORD_KUAT@127.0.0.1:3306/afvs"

# JWT — WAJIB ≥32 char acak (mis. `openssl rand -base64 48`). Tanpa ini gagal-cepat (F-01).
JWT_SECRET="GANTI_DENGAN_SECRET_ACAK_MIN_32_CHAR"
JWT_EXPIRES_IN="12h"
PIN_LOOKUP_SECRET="GANTI_DENGAN_SECRET_ACAK_LAIN_MIN_32_CHAR"

# App
PORT=3001
NODE_ENV="production"
# Domain frontend resmi (HTTPS). JANGAN localhost.
CORS_ORIGIN="https://afvs.contoh-bandara.go.id"

# File Storage + retensi biometrik (F-06)
UPLOAD_DIR="./uploads"
UPLOAD_MAX_SIZE=1048576
FACE_RETENTION_DAYS=30

# Bootstrap admin — dibuat oleh `npx ts-node prisma/seed.ts` (sekali, bila email
# belum ada). Seed menolak jalan bila password < 12 karakter atau masih contoh.
SEED_ADMIN_EMAIL="admin@contoh-bandara.go.id"
SEED_ADMIN_PASSWORD="GANTI_PASSWORD_ADMIN_KUAT"
SEED_ADMIN_NAME="Admin"
# Akun/PIN demo TIDAK di-seed di produksi kecuali SEED_ALLOW_DEMO=true (F-04).
