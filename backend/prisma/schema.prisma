// AFVS — Prisma schema
// Provider: MySQL (Laragon, dev). Skema di-apply via `prisma db push` (BUKAN
// migration history — folder prisma/migrations/ masih Postgres & stale; lihat
// docs/AUDIT-PERFORMA.md P-11/P-18). `prisma migrate dev` akan error P3019.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// NOTE: SQLite tidak support native enum — pakai string + check di app layer.
// Role: "operator" | "supervisor" | "admin"
// FlightStatus: "SCHEDULED" | "OPEN" | "ACTIVE" | "CLOSED" | "CANCELLED"

model Operator {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  pinHash      String?  // PIN cepat untuk petugas AVSEC (login-pin) — verifikasi bcrypt
  pinLookup    String?  // HMAC PIN utk lookup O(1) (login & cek-unik), BUKAN verifikasi (P-05/P-06)
  name         String
  role         String   @default("operator")
  station      String?
  active       Boolean  @default(true)
  photoPath    String?  // path foto petugas di disk (UPLOAD_DIR/operators) — disajikan auth-gated
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  scanEvents   ScanEvent[]

  @@index([station])
  @@index([pinLookup]) // login-PIN & cek-unik O(1) (P-05/P-06)
}

model Flight {
  id             String       @id @default(cuid())
  flightNumber   String
  airlineCode    String
  origin         String
  destination    String
  std            DateTime
  status         String       @default("SCHEDULED")
  station        String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  scanEvents     ScanEvent[]
  passengers     FlightPassenger[]

  @@unique([station, flightNumber, std])
  @@index([station, std])
  @@index([status])
}

// Manifest penumpang per penerbangan — diisi otomatis dari scan VALID_FLIGHT
// (lihat docs/RANCANGAN-MANIFEST-PAX.md). 1 penumpang = 1 baris per flight, kunci
// dedup = normalize(ticketNumber) || normalize(pnr). Bukan validasi scan; murni
// pencatatan/rekap agar tiap flight punya hitungan + detail pax sendiri.
model FlightPassenger {
  id             String   @id @default(cuid())
  flightId       String
  flight         Flight   @relation(fields: [flightId], references: [id], onDelete: Cascade)

  dedupKey       String   // normalize(ticket) || normalize(pnr)
  pnr            String?
  ticketNumber   String?
  seat           String?
  passengerName  String?

  firstScannedAt DateTime
  lastScannedAt  DateTime
  scanCount      Int      @default(1)
  boarded        Boolean  @default(true)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([flightId, dedupKey])
  @@index([flightId])
}

model ScanEvent {
  id               String   @id @default(cuid())
  eventId          String   @unique
  rawBarcode       String
  flightNumber     String?
  pnr              String?
  ticketNumber     String?
  seat             String?
  passengerName    String?
  resultStatus     String
  message          String?
  scannedAt        DateTime
  station          String

  facePhotoPath    String?
  ktpStatus        String?
  ktpName          String?
  ktpSimilarity    Float?
  ktpCapturedAt    DateTime?

  flightId         String?
  flight           Flight?  @relation(fields: [flightId], references: [id])

  operatorId       String
  operator         Operator @relation(fields: [operatorId], references: [id])

  createdAt        DateTime @default(now())

  @@index([station, scannedAt])
  @@index([flightId])
  @@index([resultStatus])
  @@index([flightNumber]) // filter list by flightNumber (P-11)
  @@index([scannedAt]) // filter/urut tanggal lintas-station (P-11)
}

// Pengaturan aplikasi frontend yang berlaku GLOBAL untuk semua perangkat.
// Satu baris (id = "global"); `data` = subset AppSettings yang dibagi
// (setelan khusus perangkat seperti kamera tetap di localStorage).
model AppSetting {
  id          String   @id
  data        Json
  updatedById String?
  updatedAt   DateTime @updatedAt
}
