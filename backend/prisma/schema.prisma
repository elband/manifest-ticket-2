// AFVS — Prisma schema
// Provider: MySQL (Laragon, dev). Skema di-apply via `prisma db push` (BUKAN
// migration history — folder prisma/migrations/ masih Postgres & stale; lihat
// docs/AUDIT-PERFORMA.md P-11/P-18). `prisma migrate dev` akan error P3019.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// NOTE: SQLite tidak support native enum — pakai string + check di app layer.
// Role: "operator" | "supervisor" | "admin"
// FlightStatus: "SCHEDULED" | "OPEN" | "ACTIVE" | "CLOSED" | "CANCELLED"

model Operator {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  pinHash      String?  // PIN cepat untuk petugas AVSEC (login-pin) — verifikasi bcrypt
  pinLookup    String?  // HMAC PIN utk lookup O(1) (login & cek-unik), BUKAN verifikasi (P-05/P-06)
  name         String
  role         String   @default("operator")
  station      String?
  active       Boolean  @default(true)
  photoPath    String?  // path foto petugas di disk (UPLOAD_DIR/operators) — disajikan auth-gated
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  scanEvents   ScanEvent[]
  pasScans     PasScan[]

  @@index([station])
  @@index([pinLookup]) // login-PIN & cek-unik O(1) (P-05/P-06)
}

model Flight {
  id             String       @id @default(cuid())
  flightNumber   String
  airlineCode    String
  origin         String
  destination    String
  std            DateTime
  status         String       @default("SCHEDULED")
  station        String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  scanEvents     ScanEvent[]
  passengers     FlightPassenger[]

  @@unique([station, flightNumber, std])
  @@index([station, std])
  @@index([status])
}

// Manifest penumpang per penerbangan — diisi otomatis dari scan VALID_FLIGHT
// (lihat docs/RANCANGAN-MANIFEST-PAX.md). 1 penumpang = 1 baris per flight, kunci
// dedup = normalize(ticketNumber) || normalize(pnr). Bukan validasi scan; murni
// pencatatan/rekap agar tiap flight punya hitungan + detail pax sendiri.
model FlightPassenger {
  id             String   @id @default(cuid())
  flightId       String
  flight         Flight   @relation(fields: [flightId], references: [id], onDelete: Cascade)

  dedupKey       String   // normalize(ticket) || normalize(pnr)
  pnr            String?
  ticketNumber   String?
  seat           String?
  passengerName  String?

  firstScannedAt DateTime
  lastScannedAt  DateTime
  scanCount      Int      @default(1)
  boarded        Boolean  @default(true)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([flightId, dedupKey])
  @@index([flightId])
}

model ScanEvent {
  id               String   @id @default(cuid())
  eventId          String   @unique
  // String polos = VARCHAR(191) di MySQL. Kolom di bawah bisa lebih panjang
  // (barcode s/d 512, pesan + catatan "pernah di-scan") → nilai kepanjangan
  // ditolak MySQL (P2000) dan push scan gagal 500, menahan antrean kiosk.
  rawBarcode       String   @db.VarChar(512)
  flightNumber     String?
  pnr              String?
  ticketNumber     String?
  seat             String?
  passengerName    String?  @db.VarChar(255)
  resultStatus     String
  message          String?  @db.Text
  scannedAt        DateTime
  station          String

  facePhotoPath    String?  @db.VarChar(512)
  ktpStatus        String?
  ktpName          String?  @db.VarChar(255)
  ktpSimilarity    Float?
  ktpCapturedAt    DateTime?

  flightId         String?
  flight           Flight?  @relation(fields: [flightId], references: [id])

  operatorId       String
  operator         Operator @relation(fields: [operatorId], references: [id])

  // Perangkat (kiosk) yang mengirim scan — null bila dikirim dgn token petugas.
  deviceId         String?
  device           Device?  @relation(fields: [deviceId], references: [id])

  createdAt        DateTime @default(now())

  @@index([station, scannedAt])
  @@index([flightId])
  @@index([resultStatus])
  @@index([flightNumber]) // filter list by flightNumber (P-11)
  @@index([scannedAt]) // filter/urut tanggal lintas-station (P-11)
  @@index([deviceId])
}

// Perangkat (kiosk/laptop) yang diizinkan admin mengakses backend tanpa login
// petugas. Perangkat membuat secret acak sendiri lalu mendaftar (status
// "pending"); admin mengizinkan + menentukan station → perangkat menukar
// secret-nya dengan token JWT perangkat. Status: pending | approved | revoked.
model Device {
  id           String    @id @default(cuid())
  name         String
  station      String?
  status       String    @default("pending")
  secretHash   String    @unique // sha256(secret) — secret 256-bit, tak perlu bcrypt
  code         String    // kode singkat yang tampil di perangkat, dicocokkan admin
  userAgent    String?   @db.VarChar(255)
  lastIp       String?
  lastSeenAt   DateTime?
  approvedAt   DateTime?
  approvedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  scanEvents   ScanEvent[]
  pasScans     PasScan[]

  @@index([status])
}

// Cek kartu Pas Bandara karyawan di kiosk (QR → halaman validasi
// pas.aptpairport.id). Status: VALID | EXPIRED | NOT_FOUND | ERROR.
// Foto pemegang pas TIDAK disimpan (PDP) — hanya data kartu.
model PasScan {
  id         String   @id @default(cuid())
  pasId      String   // ID hex dari URL QR
  status     String
  pasNumber  String?
  name       String?
  position   String?
  company    String?
  category   String?
  cardColor  String?
  passType   String?
  issuedAt   String?  // YYYY-MM-DD
  validUntil String?  // YYYY-MM-DD
  areaCodes  String?  // dipisah spasi, mis. "A B P V"
  station    String

  operatorId String
  operator   Operator @relation(fields: [operatorId], references: [id])
  deviceId   String?
  device     Device?  @relation(fields: [deviceId], references: [id])

  createdAt  DateTime @default(now())

  @@index([station, createdAt])
  @@index([createdAt])
  @@index([pasId])
}

// Pengaturan aplikasi frontend yang berlaku GLOBAL untuk semua perangkat.
// Satu baris (id = "global"); `data` = subset AppSettings yang dibagi
// (setelan khusus perangkat seperti kamera tetap di localStorage).
model AppSetting {
  id          String   @id
  data        Json
  updatedById String?
  updatedAt   DateTime @updatedAt
}

// Jejak audit tindakan pengguna di server (login, kelola petugas/penerbangan,
// ubah pengaturan, dst.) — dicatat otomatis oleh ActivityLogInterceptor.
// Sengaja TANPA relasi ke Operator: log harus tetap utuh walau petugasnya
// dihapus, jadi identitas pelaku disalin (snapshot) saat kejadian.
model ActivityLog {
  id            String   @id @default(cuid())
  at            DateTime @default(now())
  operatorId    String?
  operatorName  String?
  operatorEmail String?
  operatorRole  String?
  action        String   // mis. "operator.create", "auth.login_failed"
  category      String   // auth | operator | flight | settings | system
  description   String   @db.VarChar(500)
  method        String
  path          String   @db.VarChar(255)
  statusCode    Int
  success       Boolean
  targetId      String?
  ip            String?
  userAgent     String?  @db.VarChar(255)
  durationMs    Int
  meta          Json?

  @@index([at])
  @@index([operatorId, at])
  @@index([category, at])
}
