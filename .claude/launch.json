{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "backend", "run", "start:dev"],
      "port": 3001
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["next", "dev", "-p", "3000"],
      "port": 3000
    },
    {
      "name": "video-studio",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "video", "run", "studio", "--", "--port", "3100", "--no-open"],
      "port": 3100
    }
  ]
}
